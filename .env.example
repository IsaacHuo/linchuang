# 必填：赛事内网 Qwen（Chat Completions 兼容，完整请求地址，程序不拼接路径）
MODEL_NAME=replace_with_model_name
ENDPOINT=http://127.0.0.1:8000/v1/chat/completions
# 可选：赛方下发密钥时填写；为空则不发送 Authorization 头
API_KEY=
# 可选：赛事内网 BGE-M3（OpenAI 兼容 /v1/embeddings 完整地址）；为空则检索退回本地 BM25
EMBED_ENDPOINT=
EMBED_MODEL=bge-m3
# 环境变量同名设置时优先于本文件
